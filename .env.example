DASHSCOPE_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
BASE_URL=
EMBEDDING_CONCURRENCY=2
LOG_LEVEL=INFO

# Chroma 本地目录（相对路径以配置文件目录为基准）与集合前缀
CHROMA_DIRECTORY=.chroma
PDF_DIRECTORY=.documents
CHROMA_COLLECTION=knowledge
CHUNK_SIZE=600
CHUNK_OVERLAP=100
# PDF 语义拆分目标字符数（0 自动选择）；CHUNK_SIZE 作为最大字符预算
PDF_TARGET_SIZE=0
# rule 使用结构上下文；model 额外调用 CHAT_MODEL 生成上下文，失败回退 rule
PDF_CONTEXT_MODE=rule
# 图片/扫描页 OCR 依赖本机 Tesseract 及对应语言包；失败时保留图片类型并记录状态
PDF_IMAGE_OCR=true
PDF_OCR_LANGUAGE=chi_sim+eng
PDF_OCR_DPI=200
# native 原生框线/对齐解析；auto 疑难页尝试 Docling；docling 每页使用视觉表格后端
PDF_TABLE_BACKEND=native
PDF_TABLE_MODE=accurate
# Docling 需 uv sync --extra tables，并预先下载本地模型；运行时不自动下载
PDF_TABLE_MODELS_DIRECTORY=
PDF_TABLE_FALLBACK=true
INGESTION_DIRECTORY=.ingestion
INGESTION_MAX_FILES=20
INGESTION_MAX_FILE_BYTES=52428800
INGESTION_MAX_BATCH_BYTES=209715200

# 本地关键词 BM25 + 向量 RRF；vector 为仅向量检索
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=30
RETRIEVAL_RRF_CONSTANT=60
RETRIEVAL_VECTOR_WEIGHT=1
RETRIEVAL_KEYWORD_WEIGHT=1
