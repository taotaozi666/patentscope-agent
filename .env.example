DASHSCOPE_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
BASE_URL=
EMBEDDING_CONCURRENCY=2
LOG_LEVEL=INFO

# Chroma 本地目录（相对路径以配置文件目录为基准）与集合前缀
CHROMA_DIRECTORY=.chroma
PDF_DIRECTORY=.documents
CHROMA_COLLECTION=knowledge
CHUNK_SIZE=600
CHUNK_OVERLAP=100
# PDF 语义拆分目标字符数（0 自动选择）；CHUNK_SIZE 作为最大字符预算
PDF_TARGET_SIZE=0
# rule 使用结构上下文；model 额外调用 CHAT_MODEL 生成上下文，失败回退 rule
PDF_CONTEXT_MODE=rule
INGESTION_DIRECTORY=.ingestion
INGESTION_MAX_FILES=20
INGESTION_MAX_FILE_BYTES=52428800
INGESTION_MAX_BATCH_BYTES=209715200
